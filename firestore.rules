rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document rules: users/{userId}
    match /users/{userId} {
      // Unauthenticated users cannot access user data
      // Authenticated users can read public discovery profiles
      allow read: if request.auth != null;
      
      // User can create their own profile document during signup
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.trustScore == 100
                    && request.resource.data.createdAt == request.time;
      
      // User can update only their own profile
      // Cannot modify another user's profile, cannot alter trustScore, cannot overwrite createdAt
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.trustScore == resource.data.trustScore
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;
      
      // Prevent deletion of profiles by default
      allow delete: if false;
    }
  }
}
